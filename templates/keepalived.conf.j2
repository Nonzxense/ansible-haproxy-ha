vrrp_instance VI_1 {
    state {{ keepalived_role }}
    interface eth0
    virtual_router_id 51
    priority {{ keepalived_priority }}
    advert_int 1
    authentication {
        auth_type PASS
        auth_pass {{ vault_keepalived_pass }}
    }
    virtual_ipaddress {
        192.168.100.100/24
    }
}
